ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# Inovstar (token por empresa: Empresa > Integracoes > Chaves de API). Sandbox: https://gatewaydev.inovstar.com
INOVSTAR_BASE_URL=https://gateway.inovstar.com
INOVSTAR_TOKEN=inovstar_
# Signing token configurado no webhook (valida X-InovStar-Signature)
INOVSTAR_WEBHOOK_SECRET=

# Telefones que o agente pode atender (virgula). VAZIO = ninguem.
ALLOWED_NUMBERS=91981628017

# (opcional) Setor onde a IA atende / setor da fila humana para onde ela transfere
AGENT_SECTOR_ID=
HUMAN_SECTOR_ID=

# false = modo sombra (so loga a resposta, nao envia nem transfere)
AUTO_REPLY=true
DEBOUNCE_MS=4000

CLINIC_NAME=
CLINIC_KNOWLEDGE=
CLINIC_PERSONA=

# Painel visual do fluxo (GET /painel, somente leitura). Senha do Basic Auth (usuario livre). VAZIO = painel desativado (503).
PAINEL_PASSWORD=

# Roteiro (padrao) ou IA: scripted | claude
AGENT_MODE=scripted

# Consulta de agenda REAL no Clinilink (somente leitura). Sem chave = catalogo simulado.
# Crie uma credencial de perfil "ro" e ACRESCENTE em SCHEDULING_API_KEY no Render (sem apagar as existentes):
#   SCHEDULING_API_KEY=<valor atual>,agentes:ro:<chave>
CLINILINK_BASE_URL=https://lista-unilab-clinex.onrender.com
CLINILINK_API_KEY=

# Mensagem amigavel (GPT reescreve o tom; fatos validados). Sem chave = texto do roteiro.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
